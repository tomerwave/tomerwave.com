---
import { SOCIALS } from "@/constants";
// biome-ignore lint/style/useImportType: SOCIAL_ICON_PATHS is used as a value in the template below
import { SOCIAL_ICON_PATHS } from "@/utils/socialIconPaths";

export interface Props {
  centered?: boolean;
}

const { centered = false } = Astro.props;

// SOCIALS uses "twitter" where the shared icon map uses "x"
const iconKey = (icon: string) =>
  (icon === "twitter" ? "x" : icon) as keyof typeof SOCIAL_ICON_PATHS;
---

<div class:list={["flex flex-wrap items-center gap-2", { "justify-center": centered }]}>
  {
    SOCIALS.filter((social) => social.active).map((social) => (
      <a
        href={social.href}
        title={social.linkTitle}
        aria-label={social.linkTitle}
        class="social-icon-link no-underline"
        target={social.icon === "mail" ? undefined : "_blank"}
        rel={social.icon === "mail" ? undefined : "noopener noreferrer"}
      >
        {social.icon === "mail" ? (
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3.5 6.5 8.5 6 8.5-6" />
          </svg>
        ) : (
          <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d={SOCIAL_ICON_PATHS[iconKey(social.icon)]} />
          </svg>
        )}
        <span class="sr-only">{social.linkTitle}</span>
      </a>
    ))
  }
</div>

<style>
  .social-icon-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    color: currentColor;
    opacity: 0.72;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .social-icon-link:hover {
    opacity: 1;
    transform: translateY(-2px);
  }
  .social-icon-link svg {
    width: 1.2rem;
    height: 1.2rem;
  }
</style>
