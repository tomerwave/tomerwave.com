---
import TomerwaveMark from "@/components/landing/TomerwaveMark.astro";

export interface NavItem {
  label: string;
  href: string;
  active?: boolean;
  cta?: boolean;
  muted?: boolean;
  external?: boolean;
}

interface Props {
  homeHref: string;
  homeLabel: string;
  mainId: string;
  navAriaLabel: string;
  navItems: NavItem[];
}

const { homeHref, homeLabel, mainId, navAriaLabel, navItems } = Astro.props;
---

<a class="site-skip" href={`#${mainId}`}>Skip to content</a>
<header class="site-bar" id="site-bar">
  <div class="site-wrap site-bar-inner">
    <a class="site-mark" href={homeHref} aria-label={homeLabel}>
      <TomerwaveMark class="site-mark-icon" primary="var(--foreground)" accent="var(--accent)" />
      <span class="site-mark-name">Tomer Gal <em class="site-mark-handle">@tomerwave</em></span>
    </a>
    <nav class="site-nav" aria-label={navAriaLabel}>
      {
        navItems.map((item) => (
          <a
            href={item.href}
            class:list={[{ "site-nav-cta": item.cta, "site-nav-muted": item.muted, "is-active": item.active }]}
          >
            {item.label}
            {item.external && <span aria-hidden="true">↗</span>}
          </a>
        ))
      }
      <button class="site-theme-toggle" type="button" aria-label="Switch to dark theme" id="theme-btn">
        <svg class="site-theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" /></svg>
        <svg class="site-theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline data-astro-rerun>
  (function () {
    if (window.__siteHeaderAbort) window.__siteHeaderAbort.abort();
    const controller = new AbortController();
    window.__siteHeaderAbort = controller;

    const bar = document.querySelector("#site-bar");
    if (!bar) return;

    const updateBar = () => bar.classList.toggle("is-stuck", window.scrollY > 8);
    updateBar();
    window.addEventListener("scroll", updateBar, { passive: true, signal: controller.signal });
  })();
</script>
