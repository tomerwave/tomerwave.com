---
const prompt = "I’m considering working with TomerWave. Read https://tomerwave.com and the relevant service pages. Briefly explain what they do and which kinds of businesses and teams they help. Then ask me 3 short questions about my situation to help me assess whether they’re a good fit. Distinguish what the website states from your own interpretation. Include sources for factual claims. If you can’t access the pages or verify something, say so.";
const providers = [
  { name: "ChatGPT", href: "https://chatgpt.com/" },
  { name: "Gemini", href: "https://gemini.google.com/" },
  { name: "Claude", href: "https://claude.ai/" },
];
---
<section class="business-section" id="ask-ai" aria-labelledby="ask-ai-title">
  <div class="business-wrap">
    <span class="business-eyebrow">Another perspective</span>
    <h2 id="ask-ai-title">Is TomerWave a fit for you?</h2>
    <p>Ask your AI assistant, then tell it a little about what you need.</p>
    <div class="ask-ai-question">
      <label for="ask-ai-prompt">Copy this question, then choose your assistant and paste it into a new chat.</label>
      <textarea id="ask-ai-prompt" readonly rows="5">{prompt}</textarea>
      <button type="button" class="business-button" data-copy-ai-question hidden>Copy question</button>
      <p data-copy-ai-status role="status" aria-live="polite"></p>
    </div>
    <nav class="business-actions" aria-label="Ask an AI assistant">
      {providers.map((provider) => (
        <a class="business-linkline" href={provider.href} target="_blank" rel="noopener noreferrer">
          Ask {provider.name}<span class="business-arrow" aria-hidden="true">↗</span>
          <span class="ask-ai-sr"> (opens in a new tab)</span>
        </a>
      ))}
    </nav>
  </div>
</section>

<script>
  const initAIQuestion = () => {
    const button = document.querySelector<HTMLButtonElement>("[data-copy-ai-question]");
    const prompt = document.querySelector<HTMLTextAreaElement>("#ask-ai-prompt");
    const status = document.querySelector<HTMLElement>("[data-copy-ai-status]");
    if (!button || !prompt || !status || button.dataset.ready) return;
    button.dataset.ready = "true";
    button.hidden = false;
    button.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(prompt.value);
        status.textContent = "Copied. Choose your assistant below and paste the question.";
      } catch {
        prompt.focus();
        prompt.select();
        status.textContent = "Select and copy the question above, then open your assistant.";
      }
    });
  };
  initAIQuestion();
  document.addEventListener("astro:page-load", initAIQuestion);
</script>

<style>
  #ask-ai h2 { margin-block: 0.5rem 1rem; }
  .ask-ai-question { max-width: 48rem; margin-block: 1.5rem; }
  .ask-ai-question label { display: block; margin-bottom: 0.75rem; color: var(--text-muted); }
  .ask-ai-question textarea {
    display: block; width: 100%; box-sizing: border-box; resize: vertical;
    min-height: 10rem; padding: 1rem; margin-bottom: 1rem;
    border: 1px solid var(--hairline); border-radius: 0.25rem;
    background: var(--surface-warm); color: var(--text);
    font: inherit; font-size: 1rem; line-height: 1.6;
  }
  .ask-ai-question textarea:focus-visible { outline: 2px solid var(--sage-deep); outline-offset: 3px; }
  .ask-ai-question button[hidden] { display: none; }
  [data-copy-ai-status] { min-height: 1.5em; color: var(--text-muted); }
  .ask-ai-sr { position: absolute; width: 1px; height: 1px; padding: 0; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
