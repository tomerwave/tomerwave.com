---
import TomerwaveMark from "./TomerwaveMark.astro";
---
<a class="business-skip" href="#business-main">Skip to content</a>
<header class="business-bar" id="business-bar">
  <div class="business-wrap business-bar-inner">
    <a class="business-mark" href="#top" aria-label="Tomer Gal home">
      <TomerwaveMark class="business-mark-icon" />
      <span class="business-mark-name">Tomer Gal</span>
    </a>
    <nav class="business-nav" aria-label="Business navigation">
      <a href="#signals">How I help</a>
      <a href="#track">Track record</a>
      <a href="#engagements">Engagements</a>
      <a href="#writing">Writing</a>
      <a class="business-nav-cta" href="#contact">Contact</a>
      <button class="business-theme-toggle" type="button" data-business-theme-toggle aria-label="Switch to dark theme">
        <svg class="business-theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" /></svg>
        <svg class="business-theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
    </nav>
  </div>
</header>
<script>
  let barAbortController: AbortController | undefined;

  const initializeBusinessBar = () => {
    barAbortController?.abort();
    const bar = document.querySelector<HTMLElement>("#business-bar");
    const site = document.querySelector<HTMLElement>(".business-site");
    const themeToggle = document.querySelector<HTMLButtonElement>("[data-business-theme-toggle]");
    if (!bar || !site || !themeToggle) return;

    barAbortController = new AbortController();
    const updateBar = () => bar.classList.toggle("is-stuck", window.scrollY > 8);
    updateBar();
    window.addEventListener("scroll", updateBar, { passive: true, signal: barAbortController.signal });

    const setTheme = (theme: "light" | "dark") => {
      site.dataset.businessTheme = theme;
      themeToggle.setAttribute("aria-label", theme === "dark" ? "Switch to light theme" : "Switch to dark theme");
      window.dispatchEvent(new CustomEvent("business-theme-change"));
    };
    const savedTheme = window.localStorage.getItem("business-theme");
    setTheme(savedTheme === "dark" || savedTheme === "light" ? savedTheme : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    themeToggle.addEventListener("click", () => {
      const nextTheme = site.dataset.businessTheme === "dark" ? "light" : "dark";
      window.localStorage.setItem("business-theme", nextTheme);
      setTheme(nextTheme);
    }, { signal: barAbortController.signal });
  };

  document.addEventListener("astro:page-load", initializeBusinessBar);
</script>
