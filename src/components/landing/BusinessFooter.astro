---
import TomerwaveSignature from "@/components/TomerwaveSignature.astro";
import { SERVICES, servicePath } from "@/data/services";
---
<footer class="business-footer">
  <div class="business-wrap business-footer-inner">
    <TomerwaveSignature class="business-footer-identity" href="/" ariaLabel="Back to home" primary="var(--business-ink)" accent="var(--business-sage)" size="footer" />
    <nav class="business-footer-links business-footer-links--wide" aria-label="Services">
      {SERVICES.map((service) => (
        <a class="business-footer-link" href={servicePath(service.slug)}>{service.shortName}</a>
      ))}
    </nav>
    <div class="business-footer-links">
      <a class="business-footer-link" href="/blog">Writing</a>
      <span aria-hidden="true">·</span>
      <a class="business-footer-link" href="/meet">Book a call</a>
      <span aria-hidden="true">·</span>
      <span>© {new Date().getFullYear()}</span>
    </div>
  </div>
</footer>
