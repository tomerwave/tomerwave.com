---
import TomerwaveSignature from "@/components/TomerwaveSignature.astro";
---
<footer class="business-footer">
  <div class="business-wrap business-footer-inner">
    <TomerwaveSignature class="business-footer-identity" href="#top" ariaLabel="Back to top" primary="var(--business-ink)" accent="var(--business-sage)" size="footer" />
    <div class="business-footer-links">
      <a class="business-footer-link" href="/blog">Personal blog</a>
      <span aria-hidden="true">·</span>
      <span>© {new Date().getFullYear()}</span>
    </div>
  </div>
</footer>
