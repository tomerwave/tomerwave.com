---
import HeroShoreline from "@/components/HeroShoreline";
import { POSITIONING } from "@/data/positioning";
---
<section class="business-hero" id="top">
  <div class="business-hero-shore" aria-hidden="true"><HeroShoreline client:load /></div>
  <div class="business-hero-copy">
    <span class="business-eyebrow">{POSITIONING.hero.eyebrow}</span>
    <h1>{POSITIONING.hero.heading} <span class="business-quiet">{POSITIONING.hero.quiet}</span></h1>
    <p class="business-hero-sub">{POSITIONING.hero.body}</p>
    <div class="business-actions">
      <a class="business-button" href="#services">{POSITIONING.hero.cta} <span class="business-arrow" aria-hidden="true">→</span></a>
      <a class="business-linkline" href="/meet" data-placement="hero">{POSITIONING.hero.secondary}</a>
    <a class="business-linkline" href="/he/about" lang="he" dir="rtl">בעברית <span aria-hidden="true">←</span></a>
    </div>
  </div>
</section>
