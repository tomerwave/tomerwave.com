---
---
<section class="business-hero" id="top">
  <div class="business-wrap business-hero-grid">
    <div class="business-field" aria-hidden="true"><canvas id="business-field-canvas"></canvas></div>
    <div class="business-hero-copy">
      <span class="business-eyebrow">Fractional VP of R&amp;D</span>
      <h1>The best work starts before the answers are <span class="business-quiet">obvious.</span></h1>
      <p>I run engineering for startups sitting between their first hire and their first real org — architecture, delivery, and the people decisions that have to outlast me.</p>
      <div class="business-actions">
        <a class="business-button" href="#contact">Start a conversation <span class="business-arrow" aria-hidden="true">→</span></a>
        <a class="business-linkline" href="#phases">See the first ninety days</a>
      </div>
    </div>
  </div>
</section>
<script>
  const canvas = document.querySelector<HTMLCanvasElement>("#business-field-canvas");
  const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (canvas) {
    const context = canvas.getContext("2d");
    let width = 0;
    let height = 0;
    let start = 0;
    let frame = 0;
    let resize = 0;
    let dots: Array<{ x: number; y: number; jx: number; jy: number; r: number; a: number; d: number }> = [];

    const build = () => {
      if (!context) return;
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      const bounds = canvas.getBoundingClientRect();
      width = bounds.width;
      height = bounds.height;
      canvas.width = width * ratio;
      canvas.height = height * ratio;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
      dots = [];
      for (let i = 0; i < Math.round(width * 0.42); i += 1) {
        const progress = Math.pow(Math.random(), 0.55);
        if (Math.random() < Math.pow(progress, 0.85)) continue;
        const spread = Math.pow(1 - progress, 1.9) * height * 0.46;
        dots.push({
          x: progress * width * 0.98,
          y: height / 2 + (Math.random() * 2 - 1) * spread,
          jx: (Math.random() * 2 - 1) * 26 * (1 - progress),
          jy: (Math.random() * 2 - 1) * 30 * (1 - progress),
          r: 0.7 + (1 - progress) * 0.9,
          a: 0.18 + (1 - progress) * 0.46,
          d: progress * 0.55,
        });
      }
    };

    const draw = (progress: number) => {
      if (!context) return;
      context.clearRect(0, 0, width, height);
      const gradient = context.createLinearGradient(width * 0.28, 0, width, 0);
      gradient.addColorStop(0, "rgba(183,174,156,0)");
      gradient.addColorStop(0.55, "rgba(160,150,130,0.55)");
      gradient.addColorStop(1, "rgba(120,112,98,0.7)");
      context.strokeStyle = gradient;
      context.lineWidth = 1;
      context.beginPath();
      context.moveTo(width * 0.28, height / 2 + 0.5);
      context.lineTo(width * 0.28 + width * 0.72 * Math.min(1, progress * 1.15), height / 2 + 0.5);
      context.stroke();

      dots.forEach((dot) => {
        const local = Math.max(0, Math.min(1, (progress - dot.d) / (1 - dot.d)));
        const eased = 1 - Math.pow(1 - local, 3);
        context.beginPath();
        context.fillStyle = "rgba(150,140,122," + (dot.a * eased).toFixed(3) + ")";
        context.arc(dot.x + dot.jx * (1 - eased), dot.y + dot.jy * (1 - eased), dot.r, 0, Math.PI * 2);
        context.fill();
      });
    };

    const animate = (timestamp: number) => {
      if (!start) start = timestamp;
      const progress = Math.min(1, (timestamp - start) / 1900);
      draw(progress);
      if (progress < 1) frame = requestAnimationFrame(animate);
    };

    build();
    if (reduced) draw(1);
    else frame = requestAnimationFrame(animate);
    window.addEventListener("resize", () => {
      window.clearTimeout(resize);
      window.cancelAnimationFrame(frame);
      resize = window.setTimeout(() => { build(); draw(1); }, 180);
    });
  }
</script>
