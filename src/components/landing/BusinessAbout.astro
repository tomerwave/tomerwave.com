---
import { POSITIONING } from "@/data/positioning";
---
<section class="business-section business-about" id="about-work">
  <div class="business-wrap business-about-grid">
    <div class="business-reveal">
      <span class="business-eyebrow">How I work</span>
      <p class="business-about-lead">I care about the work and the people doing it.</p>
      <div class="business-about-body">
        {POSITIONING.about.paragraphs.map((paragraph, index) => <p id={index === 2 ? "end-to-end-ownership" : undefined}>{paragraph}</p>)}
        <p>I'm based in Tel Aviv and work in English or Hebrew.</p>
      </div>
      <a class="business-linkline business-about-more" href="/about">{POSITIONING.about.cta} <span class="business-arrow" aria-hidden="true">→</span></a>
    </div>
    <dl class="business-facts business-reveal">
      <div class="business-fact"><dt>Based</dt><dd>Tel Aviv, Israel · GMT+3</dd></div>
      <div class="business-fact"><dt>Started building</dt><dd>Minecraft servers, plugins &amp; mods</dd></div>
      <div class="business-fact"><dt>Leadership</dt><dd>Engineering teams through growth</dd></div>
      <div class="business-fact"><dt>Built</dt><dd>Butler AI &amp; Lumos AI</dd></div>
      <div class="business-fact"><dt>Languages</dt><dd>English &amp; Hebrew</dd></div>
    </dl>
  </div>
</section>
