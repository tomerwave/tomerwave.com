---
export interface Props {
  type: "BlogPosting" | "Person" | "Service" | "WebSite";
  data: any;
}

import { AUTHOR_SAME_AS } from "@/constants";

const { type, data } = Astro.props;
const POSITION = "Technical Advisor and Fractional VP of R&D";
const POSITION_DESCRIPTION =
  "Tomer Gal helps teams and organizations make high-stakes technical decisions and execute them across R&D leadership, architecture, AI automation, and technology advisory.";

let structuredData = {};

if (type === "BlogPosting") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    author: {
      "@type": "Person",
      name: data.author || "Tomer Gal",
      url: "https://tomerwave.com/about",
      sameAs: AUTHOR_SAME_AS,
    },
    datePublished: data.pubDatetime.toISOString(),
    dateModified: data.modDatetime?.toISOString() || data.pubDatetime.toISOString(),
    publisher: {
      "@type": "Person",
      name: "Tomer Gal",
      logo: {
        "@type": "ImageObject",
        url: "https://tomerwave.com/avatar.jpg",
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": data.url,
    },
    image: data.ogImage || "https://tomerwave.com/avatar.jpg",
    articleSection: data.tags?.[0] || "Technology",
    keywords: data.tags?.join(", ") || "",
    wordCount: data.wordCount,
    timeRequired: data.readingTime,
  };
} else if (type === "Person") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Tomer Gal",
    url: "https://tomerwave.com",
    image: "https://tomerwave.com/avatar.jpg",
    sameAs: AUTHOR_SAME_AS,
    jobTitle: POSITION,
    description: POSITION_DESCRIPTION,
    email: "mailto:tomer@tomerwave.com",
    knowsLanguage: ["en", "he"],
  };
} else if (type === "Service") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    name: data.name,
    description: data.description,
    url: data.url,
    serviceType: data.serviceType,
    provider: {
      "@type": "Person",
      name: "Tomer Gal",
      url: "https://tomerwave.com",
      jobTitle: POSITION,
      sameAs: AUTHOR_SAME_AS,
      knowsLanguage: ["en", "he"],
    },
    areaServed: [
      { "@type": "Country", name: "Israel" },
      { "@type": "AdministrativeArea", name: "Remote, worldwide" },
    ],
    ...(data.offer && {
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: `${data.name}: how to start`,
        itemListElement: [
          {
            "@type": "Offer",
            name: data.offer.name,
            description: data.offer.description,
            url: `${data.url}#${data.offer.anchor}`,
            category: "Entry engagement",
            ...(data.offer.duration && { eligibleDuration: data.offer.duration }),
          },
        ],
      },
    }),
  };
} else if (type === "WebSite") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Tomer Gal",
    url: "https://tomerwave.com",
    description:
      "Technical strategy and hands-on execution for teams and organizations making expensive technical decisions.",
    author: {
      "@type": "Person",
      name: "Tomer Gal",
      url: "https://tomerwave.com",
    },
  };
}
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
