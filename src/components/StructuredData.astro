---
export interface Props {
  type: "BlogPosting" | "Person" | "Service" | "WebSite";
  data: any;
}

const { type, data } = Astro.props;

let structuredData = {};

if (type === "BlogPosting") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    headline: data.title,
    description: data.description,
    author: {
      "@type": "Person",
      name: data.author || "Tomer Gal",
      url: "https://tomerwave.com/about",
    },
    datePublished: data.pubDatetime.toISOString(),
    dateModified: data.modDatetime?.toISOString() || data.pubDatetime.toISOString(),
    publisher: {
      "@type": "Person",
      name: "Tomer Gal",
      logo: {
        "@type": "ImageObject",
        url: "https://tomerwave.com/avatar.jpg",
      },
    },
    mainEntityOfPage: {
      "@type": "WebPage",
      "@id": data.url,
    },
    image: data.ogImage || "https://tomerwave.com/avatar.jpg",
    articleSection: data.tags?.[0] || "Technology",
    keywords: data.tags?.join(", ") || "",
    wordCount: data.wordCount,
    timeRequired: data.readingTime,
  };
} else if (type === "Person") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "Person",
    name: "Tomer Gal",
    url: "https://tomerwave.com",
    image: "https://tomerwave.com/avatar.jpg",
    sameAs: [
      "https://github.com/tomerwave",
      "https://x.com/TomerWave",
      "https://www.linkedin.com/in/tomergal14",
    ],
    jobTitle: "Fractional VP of R&D and Software Engineer",
    description:
      "Tomer Gal works with founder-led startups and writes honestly about work, ambition, love, family, and everything underneath.",
  };
} else if (type === "Service") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    name: data.name,
    description: data.description,
    url: data.url,
    serviceType: data.serviceType,
    provider: {
      "@type": "Person",
      name: "Tomer Gal",
      url: "https://tomerwave.com",
      jobTitle: "Fractional VP of R&D and Software Engineer",
    },
    areaServed: [
      { "@type": "Country", name: "Israel" },
      { "@type": "AdministrativeArea", name: "Remote, worldwide" },
    ],
    availableLanguage: ["English", "Hebrew"],
    ...(data.offer && {
      hasOfferCatalog: {
        "@type": "OfferCatalog",
        name: `${data.name}: how to start`,
        itemListElement: [
          {
            "@type": "Offer",
            name: data.offer.name,
            description: data.offer.description,
            url: `${data.url}#${data.offer.anchor}`,
            category: "Entry engagement",
            ...(data.offer.duration && { eligibleDuration: data.offer.duration }),
          },
        ],
      },
    }),
  };
} else if (type === "WebSite") {
  structuredData = {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: "Tomer Gal",
    url: "https://tomerwave.com",
    description:
      "Essays about work, ambition, love, family, and the things that are hardest to say out loud.",
    author: {
      "@type": "Person",
      name: "Tomer Gal",
    },
  };
}
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
