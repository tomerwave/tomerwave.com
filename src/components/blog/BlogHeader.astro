---
const { pathname } = Astro.url;
const isWriting = pathname === "/blog" || pathname.startsWith("/posts");
---
<a class="blog-skip" href="#blog-main">Skip to posts</a>
<header class="blog-bar">
  <div class="blog-wrap blog-bar-inner">
    <a class="blog-mark" href="/blog" aria-label="Tomer Gal personal blog">
      <img src="/tomerwave-icon.svg" alt="" width="32" height="32" />
      <span>Tomer Gal <em>@tomerwave</em></span>
    </a>
    <nav class="blog-nav" aria-label="Personal blog navigation">
      <a class:list={{ "is-active": isWriting }} href="/blog">Writing</a>
      <a class:list={{ "is-active": pathname === "/about" }} href="/about">About</a>
      <a class="blog-nav-business" href="/">Studio <span aria-hidden="true">↗</span></a>
      <button class="blog-theme-toggle" type="button" aria-label="Switch to dark theme" data-blog-theme-toggle>
        <svg class="blog-theme-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3 7 7 0 0 0 21 12.8Z" /></svg>
        <svg class="blog-theme-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
    </nav>
  </div>
</header>

<script is:inline data-astro-rerun>
  const blogRoot = document.querySelector(".personal-blog");
  const blogThemeToggle = document.querySelector("[data-blog-theme-toggle]");

  if (blogRoot && blogThemeToggle) {
    const storedTheme = localStorage.getItem("blog-theme");
    const theme = storedTheme || (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
    blogRoot.dataset.blogTheme = theme;
    blogThemeToggle.setAttribute("aria-label", theme === "dark" ? "Switch to light theme" : "Switch to dark theme");
    blogThemeToggle.onclick = () => {
      const nextTheme = blogRoot.dataset.blogTheme === "dark" ? "light" : "dark";
      blogRoot.dataset.blogTheme = nextTheme;
      localStorage.setItem("blog-theme", nextTheme);
      blogThemeToggle.setAttribute("aria-label", nextTheme === "dark" ? "Switch to light theme" : "Switch to dark theme");
    };
  }
</script>
