---
import BlogFooter from "@/components/blog/BlogFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { SITE } from "@/config";
import "@/styles/blog.css";
import Layout from "./Layout.astro";

const navItems = [
  { label: "Writing", href: "/blog" },
  { label: "About", href: "/about", active: true },
  { label: "Studio", href: "/", muted: true, external: true },
];

export interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<Layout title={`${frontmatter.title} | ${SITE.title}`} description={frontmatter.description}>
  <div class="personal-blog">
    <SiteHeader
      homeHref="/blog"
      homeLabel="Tomer Gal personal blog"
      mainId="blog-main"
      navAriaLabel="Personal blog navigation"
      navItems={navItems}
    />
    <main id="blog-main" class="blog-about">
      <section id="about" class="blog-about-column blog-prose">
        <span class="blog-kicker">About</span>
        <slot />
      </section>
    </main>
    <BlogFooter />
  </div>
</Layout>
