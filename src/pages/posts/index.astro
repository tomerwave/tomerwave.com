---
import { getCollection } from "astro:content";
import BlogFooter from "@/components/blog/BlogFooter.astro";
import BlogPostItem from "@/components/blog/BlogPostItem.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { SITE } from "@/consts";
import Layout from "@/layouts/Layout.astro";
import "@/styles/blog.css";
import getPostsByGroupCondition from "@/utils/get-posts-by-group-condition";
import postFilter from "@/utils/post-filter";

const navItems = [
  { label: "Writing", href: "/blog", active: true },
  { label: "About", href: "/about" },
  { label: "Studio", href: "/", muted: true, external: true },
];

const posts = await getCollection("blog", postFilter);
const months = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];
const postsByYear = Object.entries(
  getPostsByGroupCondition(posts, (post) =>
    new Date(post.data.pubDatetime || new Date()).getFullYear()
  )
).sort(([yearA], [yearB]) => Number(yearB) - Number(yearA));
---

<Layout title={`All writing | ${SITE.title}`} description="All of Tomer Gal's essays about work, ambition, love, family, and everything underneath.">
  <div class="personal-blog">
    <SiteHeader
      homeHref="/blog"
      homeLabel="Tomer Gal personal blog"
      mainId="blog-main"
      navAriaLabel="Personal blog navigation"
      navItems={navItems}
    />
    <main id="blog-main" class="blog-archive">
      <div class="blog-wrap">
        <h1>All writing.</h1>
        <p class="blog-archive-intro">Essays about work, ambition, love, family, and everything underneath.</p>
      </div>
      <div class="blog-archive-list">
        {
          postsByYear.map(([year, yearGroup]) => (
            <section class="blog-archive-year" aria-labelledby={`year-${year}`}>
              <h2 id={`year-${year}`}>{year}</h2>
              {
                Object.entries(
                  getPostsByGroupCondition(yearGroup, (post) => new Date(post.data.pubDatetime || new Date()).getMonth() + 1),
                )
                  .sort(([monthA], [monthB]) => Number(monthB) - Number(monthA))
                  .map(([month, monthGroup]) => (
                    <div class="blog-archive-month">
                      <h3>{months[Number(month) - 1]}</h3>
                      <ul class="blog-posts">
                        {monthGroup
                          .sort((a, b) => new Date(b.data.pubDatetime || new Date()).getTime() - new Date(a.data.pubDatetime || new Date()).getTime())
                          .map((post) => <BlogPostItem {post} />)}
                      </ul>
                    </div>
                  ))
              }
            </section>
          ))
        }
      </div>
    </main>
    <BlogFooter />
  </div>
</Layout>
