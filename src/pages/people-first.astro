---
import Layout from "@/layouts/Layout.astro";
import content from "@/data/people-first.json";
import iconMarkup from "../../public/tomerwave-icon.svg?raw";
const icon = iconMarkup.replace(/<rect[^>]*\/>/, "").replace(/<svg[^>]*>/, '<svg viewBox="0 0 1254 1254" aria-hidden="true">');
---
<Layout title="People First · Worksheets · Tomer Gal" description={content.intro} canonicalURL="https://tomerwave.com/people-first">
  <main class="people">
    <nav aria-label="Page navigation"><a class="mark" href="/"><Fragment set:html={icon} /><span>Tomer Gal</span></a><a href="#sheets">The worksheets ↓</a></nav>
    <header>
      <p class="eyebrow">PEOPLE FIRST / WORKING SHEETS</p>
      <h1>{content.headline}</h1>
      <p class="intro">{content.intro}</p>
      <div class="downloads"><a class="download" href="/people-first/frameworks-en.pdf" download="TomerWave-Frameworks-EN.pdf">Download in English</a><a class="download secondary" href="/people-first/frameworks-he.pdf" download="TomerWave-Frameworks-HE.pdf" lang="he" dir="rtl">הורדה בעברית</a></div><a class="text-link" href="/people-first/toolkit.html">Fill in the worksheets online</a>
      <p class="detail">PDF · Four A4 pages per language · Free to use · No signup</p>
    </header>
    <section id="sheets" aria-label="The four frameworks">
      <p class="note">{content.note}</p>
      <div class="sheets">{content.sheets.map(sheet => <article>
        <span class="number">{sheet.number}</span><h2>{sheet.title}</h2><p>{sheet.intro}</p>
        <details><summary>See the questions</summary><dl>{sheet.prompts.map(([title, prompt]) => <div><dt>{title}</dt><dd>{prompt}</dd></div>)}</dl></details>
      </article>)}</div>
      <p class="note">For the exercise from the talk: <a class="text-link" href="/people-first/workbook.pdf" target="_blank" rel="noopener">Download the three-page decision exercise</a></p>
    </section>
    <section class="workshop" aria-labelledby="workshop-title"><p class="eyebrow">A PRACTICAL WORKSHOP</p><h2 id="workshop-title">{content.workshopTitle}</h2><p>{content.workshopText}</p><a class="text-link" href="mailto:tomer@tomerwave.com?subject=People%20First%20workshop">{content.workshopLink}</a></section>
    <footer><a href="/">tomerwave.com</a><a href="mailto:tomer@tomerwave.com">tomer@tomerwave.com</a></footer>
  </main>
</Layout>
<style>
.people{--paper:#faf6ef;--ink:#24352f;--sage:#526c59;--hair:#c8cec3;background:var(--paper);color:var(--ink);font-family:'Instrument Sans',sans-serif;min-height:100vh;padding:0 max(24px,calc((100vw - 1120px)/2));line-height:1.6}
.people *{box-sizing:border-box}nav,footer{display:flex;justify-content:space-between;align-items:center;gap:24px;padding:28px 0;border-bottom:1px solid var(--hair);font-size:14px}a{color:inherit;text-decoration:none}.mark{display:flex;align-items:center;gap:13px;font-family:'Fraunces',serif;font-size:21px}.mark :global(svg){height:29px;width:29px}header{padding:88px 0 70px;max-width:860px}.eyebrow{color:var(--sage);font-size:12px;letter-spacing:.12em;margin:0 0 22px}h1,h2{font-family:'Fraunces',serif;font-weight:400;line-height:1.1;letter-spacing:-.025em}h1{font-size:clamp(46px,7vw,80px);margin:0 0 28px}.intro{font-size:clamp(19px,2vw,23px);max-width:730px;margin-bottom:32px}.download{display:inline-flex;gap:48px;background:var(--ink);color:var(--paper);padding:17px 24px;border-radius:3px;font-size:17px}.detail{font-size:13px;color:var(--sage);margin-top:13px}.note{max-width:730px;margin:0 0 34px;color:var(--sage)}#sheets{border-top:1px solid var(--hair);padding:36px 0 60px;scroll-margin-top:20px}.sheets{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:40px;margin-bottom:35px}article{border-top:1px solid var(--hair);padding-top:24px}.number{font-family:'Fraunces',serif;font-size:35px;color:var(--sage)}article h2{font-size:29px;margin:22px 0 17px}article p{font-size:16px}summary{cursor:pointer;min-height:44px;padding-top:12px;text-decoration:underline;text-underline-offset:5px;font-size:14px}dl{font-size:14px}dt{margin-top:20px;font-weight:600}dd{margin:5px 0}.text-link{display:inline-block;border-bottom:1px solid var(--sage);padding:6px 0;min-height:44px}.workshop{border-top:1px solid var(--hair);padding:50px 0 65px;max-width:850px}.workshop h2{font-size:40px;margin:0 0 22px}.workshop p:not(.eyebrow){font-size:19px;max-width:730px}footer{border-top:1px solid var(--hair);border-bottom:0;padding:25px 0 35px;color:var(--sage)}a:focus-visible,summary:focus-visible{outline:2px solid var(--sage);outline-offset:6px}a:hover{text-decoration:underline;text-underline-offset:5px}@media(max-width:720px){header{padding:55px 0 45px}.sheets{grid-template-columns:1fr;gap:30px}.workshop h2{font-size:33px}footer{align-items:flex-start;flex-direction:column;gap:8px}.download{gap:22px}}
.downloads{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:10px}.secondary{background:transparent;color:var(--ink);border:1px solid var(--ink)}
</style>
