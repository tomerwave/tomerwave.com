---
import BusinessAbout from "@/components/landing/BusinessAbout.astro";
import BusinessContact from "@/components/landing/BusinessContact.astro";
import BusinessFooter from "@/components/landing/BusinessFooter.astro";
import BusinessHero from "@/components/landing/BusinessHero.astro";
import ConsultingWork from "@/components/landing/ConsultingWork.astro";
import ServiceRouter from "@/components/landing/ServiceRouter.astro";
import TrackRecord from "@/components/landing/TrackRecord.astro";
import WritingBridge from "@/components/landing/WritingBridge.astro";
import SectionRoute from "@/components/SectionRoute.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import StructuredData from "@/components/StructuredData.astro";
import "@/styles/business.css";
import "@/styles/route.css";
import Layout from "@/layouts/Layout.astro";

const routeSections = [
  { id: "top", label: "Top" },
  { id: "services", label: "Services" },
  { id: "track", label: "Track record" },
  { id: "consulting", label: "Work" },
  { id: "writing", label: "Writing" },
  { id: "contact", label: "Contact" },
];

const navItems = [
  { label: "Services", href: "#services" },
  { label: "Track record", href: "#track" },
  { label: "Work", href: "#consulting" },
  { label: "Writing", href: "#writing" },
  { label: "Let’s talk", href: "/meet", cta: true },
];
---

<Layout
  title="Tomer Gal — Technical strategy and hands-on execution"
  description="I help teams and organizations make the technical calls that are easy to postpone and expensive to get wrong. Strategy when you need direction. Hands-on execution when you need things done."
>
  <div class="business-site">
    <StructuredData type="WebSite" data={{}} />
    <StructuredData type="Person" data={{}} />
    <SiteHeader
      homeHref="#top"
      homeLabel="Tomer Gal home"
      mainId="business-main"
      navAriaLabel="Business navigation"
      navItems={navItems}
      variant="business"
    />
    <SectionRoute sections={routeSections} />
    <main id="business-main">
      <BusinessHero />
      <ServiceRouter />
      <hr class="business-rule" />
      <TrackRecord />
      <hr class="business-rule" />
      <ConsultingWork />
      <BusinessAbout />
      <hr class="business-rule" />
      <WritingBridge />
      <BusinessContact />
    </main>
    <BusinessFooter />
  </div>
</Layout>

