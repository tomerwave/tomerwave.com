---
import BusinessAbout from "@/components/landing/BusinessAbout.astro";
import BusinessContact from "@/components/landing/BusinessContact.astro";
import BusinessFooter from "@/components/landing/BusinessFooter.astro";
import BusinessHeader from "@/components/landing/BusinessHeader.astro";
import BusinessHero from "@/components/landing/BusinessHero.astro";
import EngagementModes from "@/components/landing/EngagementModes.astro";
import EngagementPhases from "@/components/landing/EngagementPhases.astro";
import FounderSignals from "@/components/landing/FounderSignals.astro";
import StructuredData from "@/components/StructuredData.astro";
import "@/styles/business.css";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title="Tomer Gal — Fractional VP R&D"
  description="Fractional VP of R&D for startups between their first engineering hire and their first real organization."
>
  <div class="business-site">
    <StructuredData type="WebSite" data={{}} />
    <StructuredData type="Person" data={{}} />
    <BusinessHeader />
    <main id="business-main">
      <BusinessHero />
      <hr class="business-rule" />
      <FounderSignals />
      <EngagementPhases />
      <hr class="business-rule" />
      <EngagementModes />
      <BusinessAbout />
      <BusinessContact />
    </main>
    <BusinessFooter />
  </div>
</Layout>

<script>
  const initializeBusinessReveals = () => {
    const revealItems = document.querySelectorAll<HTMLElement>(".business-reveal");

    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches || !("IntersectionObserver" in window)) {
      revealItems.forEach((item) => item.classList.add("is-visible"));
      return;
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      { threshold: 0.16, rootMargin: "0px 0px -8% 0px" },
    );
    revealItems.forEach((item) => observer.observe(item));
  };

  document.addEventListener("astro:page-load", initializeBusinessReveals);
</script>
