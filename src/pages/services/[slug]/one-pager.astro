---
import { SITE } from "@/config";
import { SERVICES, type Service, servicePath } from "@/data/services";
import Layout from "@/layouts/Layout.astro";
/* The printable one-pager for a service.
   Everything on this page comes out of SERVICES, so it cannot drift from the
   service page it summarises: change the copy once and both surfaces move.
   The counts below are the only editorial decision the sheet makes on its own,
   and they exist because A4 is a fixed height. */
import iconMarkup from "../../../../public/tomerwave-icon.svg?raw";
import "@/styles/onepager.css";

/* The line under the name is who he is, not what the sheet argues — the
   eyebrow at the top already carries the service. */
const SHEET_ROLE = "Fractional VP of R&D for founder-led startups";

const TRIGGER_COUNT = 3;
const DELIVERABLE_COUNT = 4;
const HELP_PARAGRAPHS = 2;

export async function getStaticPaths() {
  return SERVICES.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

const { service } = Astro.props as { service: Service };

const onePagerPath = `${servicePath(service.slug)}/one-pager`;
const canonical = new URL(onePagerPath, SITE.website).href;

/* The icon file paints its own cream background so it works as a favicon.
   On paper the sheet already is that cream, so the ground square is dropped. */
const icon = iconMarkup
  .replace(/<rect[^>]*\/>/, "")
  .replace(/<svg[^>]*>/, '<svg viewBox="0 0 1254 1254" class="onepager-icon" aria-hidden="true">');

/* Three of the four ledes open by restating routerProblem, which is fine on the
   service page (the two sit in different sections) but reads as a stutter here,
   where the headline is the problem and the lede sits directly under it. Drop
   that opening sentence when it is carrying the headline again. */
const words = (value: string) => value.toLowerCase().match(/[a-z']+/g) ?? [];

const dropEchoedOpening = (lede: string, headline: string) => {
  const sentences = lede.match(/[^.!?]+[.!?]+\s*/g);
  if (!sentences || sentences.length < 2) return lede;

  const opening = new Set(words(sentences[0]));
  const headlineWords = words(headline);
  const shared = headlineWords.filter((word) => opening.has(word)).length;

  return shared / headlineWords.length >= 0.7 ? sentences.slice(1).join("").trim() : lede;
};

/* Same bold-to-strong pass the service page runs on these paragraphs. */
const emphasise = (paragraph: string) => paragraph.replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>");

const triggers = service.triggers.slice(0, TRIGGER_COUNT);
const deliverables = service.offer.deliverable.slice(0, DELIVERABLE_COUNT);
const help = service.help.body.slice(0, HELP_PARAGRAPHS);
const lede = dropEchoedOpening(service.lede, service.routerProblem);
---

<Layout
  title={`${service.shortName} · One-pager · Tomer Gal`}
  description={service.description}
  canonicalURL={canonical}
  noindex={true}
>
  <div class="onepager">
    <div class="onepager-bar">
      <button class="onepager-print" type="button" data-onepager-print>Print / save as PDF</button>
      <a class="onepager-back" href={servicePath(service.slug)}>Back to {service.shortName}</a>
    </div>

    <article class="onepager-sheet">
      <header class="onepager-top onepager-pad">
        <div class="onepager-mark">
          <Fragment set:html={icon} />
          <span class="onepager-name">Tomer Gal</span>
        </div>
        <span class="onepager-eyebrow">{service.eyebrow}</span>
      </header>
      <hr class="onepager-rule" />

      <div class="onepager-hero onepager-pad">
        <h1>{service.routerProblem}</h1>
        <p class="onepager-lede">{lede}</p>
      </div>
      <hr class="onepager-rule" />

      <div class="onepager-cols onepager-pad">
        <div>
          <span class="onepager-eyebrow">The reason people call</span>
          <h2>This sounds familiar if…</h2>
          <ul class="onepager-triggers">
            {triggers.map((trigger) => <li>{trigger}</li>)}
          </ul>
        </div>
        <div>
          <span class="onepager-eyebrow">How this works</span>
          <h2>{service.help.heading}</h2>
          <div class="onepager-help">
            {help.map((paragraph) => <p set:html={emphasise(paragraph)} />)}
          </div>
        </div>
      </div>

      <div class="onepager-offer onepager-pad">
        <div class="onepager-offer-grid">
          <div>
            <p class="onepager-offer-name">{service.offer.name}</p>
            <h2>{service.offer.heading}</h2>
            <p class="onepager-offer-intro">{service.offer.intro}</p>
            <dl class="onepager-terms">
              <div class="onepager-term">
                <dt>How long</dt>
                <dd>{service.offer.duration}</dd>
              </div>
              <div class="onepager-term">
                <dt>Where</dt>
                <dd>Tel Aviv, or remote</dd>
              </div>
            </dl>
          </div>
          <div>
            <p class="onepager-offer-label">What you get back</p>
            <ul class="onepager-list">
              {deliverables.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        </div>
      </div>

      <div class="onepager-close onepager-pad">
        <p class="onepager-opinion">{service.help.opinion}</p>
        <figure class="onepager-me">
          <img alt="Tomer Gal" height="62" src="/avatar.jpg" width="62" />
          <figcaption>
            Tomer Gal
            <span class="onepager-role">{SHEET_ROLE}</span>
          </figcaption>
        </figure>
      </div>

      <footer class="onepager-foot onepager-pad">
        <a class="onepager-mail" href="mailto:tomer.wave@gmail.com">tomer.wave@gmail.com</a>
        <span class="onepager-cta">Let’s talk · tomerwave.com/meet</span>
      </footer>
    </article>
  </div>

  <script>
    const bind = () => {
      const button = document.querySelector<HTMLButtonElement>("[data-onepager-print]");
      if (button) button.onclick = () => window.print();
    };

    bind();
    document.addEventListener("astro:page-load", bind);
  </script>
</Layout>
