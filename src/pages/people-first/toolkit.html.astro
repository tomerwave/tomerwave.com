---
import worksheets from '@/data/people-first-toolkit.html?raw';
import '@/styles/people-language.css';
---
<!doctype html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>People First | TomerWave worksheets</title>
<meta name="description" content="Fill in the four People First worksheets in English or Hebrew and save a PDF with your answers." />
<style is:global>
@font-face{font-family:Assistant;src:url(/fonts/assistant-hebrew.woff2);font-weight:100 900;}@font-face{font-family:Frank;src:url(/fonts/frank-ruhl-libre-hebrew.woff2);font-weight:100 900;}@font-face{font-family:Fraunces;src:url(/fonts/fraunces-latin.woff2);font-weight:100 900;}@font-face{font-family:Instrument;src:url(/fonts/instrument-sans-latin.woff2);font-weight:100 900;}
*{box-sizing:border-box}body{margin:0;background:#e7e8e1;color:#2e3338;font:14px/1.45 Instrument,Assistant,sans-serif} .page{width:210mm;min-height:297mm;padding:13mm 16mm;background:#faf7f0;margin:20px auto;position:relative;break-after:page}.page[dir=rtl]{font-family:Assistant,Instrument,sans-serif;font-size:15px}header{display:flex;justify-content:space-between;align-items:center;border-bottom:1px solid #d5d8cf;padding-bottom:12px;margin-bottom:19px}.brand{white-space:nowrap;flex-shrink:0;display:flex;align-items:center;gap:10px;direction:ltr;font:19px Fraunces}.brand img{width:25px;flex-shrink:0}.micro{font:10px Instrument;color:#5f7368;letter-spacing:1px}.eyebrow{color:#5f7368;font-size:12px;margin-bottom:6px}h1{font:38px/1.12 Fraunces,Frank,serif;margin:0 0 9px}.page[dir=rtl] h1{font-family:Frank;font-size:42px}h2{font-size:14px;font-weight:600;margin:14px 0 7px;color:#5f7368}p{margin:0 0 10px}.subtitle{font-size:19px;color:#5f7368;margin-bottom:13px}.intro{font-size:14px}.page[dir=rtl] .intro{font-size:15px}ol{padding-inline-start:23px;margin:0 0 12px}li{padding-inline-start:4px;margin:5px 0}.example{background:#f0eadf;border-inline-start:3px solid #8fa396;padding:10px 13px;margin:12px 0;font-size:12px}.example strong{display:block;font-size:11px;letter-spacing:.2px;color:#5f7368;margin-bottom:4px}.example p{margin:0}.page[dir=rtl] .example{font-size:13px}.meta{display:flex;gap:14px;padding:4px 0 12px;margin-bottom:8px;font-size:12px}.meta input{display:block;width:100%;height:36px;margin-top:8px;padding:7px 9px;font:inherit;border:1px solid #b9c2b7;border-radius:3px;background:#fffdf8}.meta input:focus{outline:2px solid #5f7368;outline-offset:2px}.meta label{flex:1;min-width:0;font-weight:600}.fields{display:grid;grid-template-columns:1fr 1fr;gap:10px 14px}.field{min-width:0}.field label{font-weight:600;font-size:12px;display:block;margin-bottom:3px}.field .hint{font-size:10px;line-height:1.3;color:#737b74;min-height:27px;margin:0 0 4px}.field textarea{display:block;background:#fffdf8;border:1px solid #d5d8cf;border-radius:2px;resize:vertical;width:100%;height:76px;font:13px/1.4 inherit;padding:6px}.result{color:#5f7368;font-size:12px;border-top:1px solid #d5d8cf;padding-top:10px;margin-top:14px}footer{position:absolute;bottom:10mm;left:16mm;right:16mm;display:flex;justify-content:space-between;font-size:10px;color:#68766c}.toolbar{padding:12px;background:#2e3338;color:white;position:sticky;top:0;z-index:2;text-align:center}.toolbar button{font:14px Assistant,Instrument;padding:8px 13px;margin:3px;border:0;border-radius:3px;cursor:pointer}.toolbar small{display:block;margin:6px}.hidden{display:none}
.page[dir=rtl] .fields{direction:ltr}.page[dir=rtl] .field{direction:rtl}.page[dir=rtl] .field:nth-child(odd){grid-column:2}.page[dir=rtl] .field:nth-child(even){grid-column:1}.page[dir=rtl] .field:nth-child(1),.page[dir=rtl] .field:nth-child(2){grid-row:1}.page[dir=rtl] .field:nth-child(3),.page[dir=rtl] .field:nth-child(4){grid-row:2}@page{size:A4;margin:0}@media print{body{background:#faf7f0}.toolbar{display:none}.page{margin:0}.page:last-child{break-after:auto}textarea{resize:none!important}*{print-color-adjust:exact}}@media screen and (max-width:800px){.page{width:100%;height:auto;min-height:0;padding:25px 20px;margin:12px 0}footer{position:static;margin-top:22px}.fields{display:block}.field{width:100%;margin:12px 0}.field textarea{height:85px}h1{font-size:34px}}
.back-link{display:inline-block;color:white;margin:3px 14px;font:14px Instrument,Assistant,sans-serif} .field textarea{font-family:Instrument,Assistant,sans-serif;font-size:14px;line-height:1.5} 
[hidden]{display:none!important}
.toolbar{display:flex;flex-wrap:wrap;gap:12px;align-items:center;text-align:start;padding:14px max(20px,calc((100vw - 790px)/2));background:#faf6ef;color:#24352f;border-bottom:1px solid #c8cec3;direction:ltr}
.toolbar .back-link{color:inherit;margin:0 auto 0 0;text-decoration:none;font-family:Fraunces,Frank,serif;font-size:20px}
.toolbar select{font:15px Instrument,Assistant,sans-serif;min-height:44px;padding:8px 12px;border:1px solid #526c59;border-radius:4px;background:#faf6ef;color:#24352f;direction:ltr}
.toolbar button{margin:0;min-height:44px;background:#24352f;color:#faf6ef;font-family:Instrument,Assistant,sans-serif}
.toolbar button:disabled{opacity:.65;cursor:wait}
.toolbar .help{flex-basis:100%;font:13px/1.5 Instrument,Assistant,sans-serif;color:#526c59;margin:0}
.toolbar .help[lang=he]{direction:rtl;text-align:right}
#status,#pdf-result{font:13px/1.5 Instrument,Assistant,sans-serif}
#status:empty{display:none}#pdf-result{color:#24352f;text-decoration:underline}
html[dir=rtl] #status,html[dir=rtl] #pdf-result{direction:rtl}
.field textarea{min-height:100px;padding:10px;line-height:1.6}
.field label{margin-top:12px;margin-bottom:6px}
.field .hint{margin-bottom:9px}
footer{position:static;margin-top:24px}
select:focus-visible,button:focus-visible,a:focus-visible{outline:2px solid #526c59;outline-offset:4px}
@media(max-width:500px){.toolbar{padding:10px 14px;gap:8px}.toolbar .back-link{font-size:17px}.toolbar button{font-size:13px;padding:8px 10px}.toolbar select{font-size:13px;padding:8px}.toolbar .help{font-size:12px}}
@media print{.toolbar{display:none!important}.page{height:auto;min-height:0}textarea{height:auto;overflow:visible}}
</style>
</head>
<body>
<div class="toolbar">
<a class="back-link" href="/people-first" data-language-link>People First</a>
<button id="save-pdf" type="button">Save PDF</button>
<select id="language-select" aria-label="Language / שפה">
<option value="en">English</option><option value="he">עברית</option>
</select>
<p class="help" data-lang="en" lang="en">Fill in the sheets, then save a PDF with your answers. Your answers stay in this tab until you save them.</p>
<p class="help" data-lang="he" lang="he" hidden>ממלאים את הדפים ושומרים PDF עם התשובות. עד השמירה, התשובות נשארות רק בלשונית הזאת.</p>
<span id="status" role="status" aria-live="polite"></span>
<a id="pdf-result" hidden target="_blank" rel="noopener"></a>
</div>
<Fragment set:html={worksheets} />
<script>
import '../../scripts/people-toolkit';
</script>
</body>
</html>
