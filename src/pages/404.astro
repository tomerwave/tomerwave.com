---
import BlogFooter from "@/components/blog/BlogFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { SITE } from "@/config";
import Layout from "@/layouts/Layout.astro";
import "@/styles/blog.css";

const navItems = [
  { label: "Writing", href: "/blog" },
  { label: "About", href: "/about" },
  { label: "Studio", href: "/", muted: true, external: true },
];
---

<Layout title={`Page not found | ${SITE.title}`} description="The requested page doesn't exist." noindex>
  <div class="personal-blog">
    <SiteHeader
      homeHref="/blog"
      homeLabel="Tomer Gal personal blog"
      mainId="not-found-main"
      navAriaLabel="Personal blog navigation"
      navItems={navItems}
    />
    <main id="not-found-main" class="blog-not-found">
      <section class="blog-wrap">
        <span class="blog-kicker">404</span>
        <h1>Nothing here.</h1>
        <p>I probably moved it, deleted it, or never wrote it in the first place.</p>
        <a class="blog-archive-link" href="/blog">Back to the writing <span aria-hidden="true">→</span></a>
        <p>
          Try the <a href="/">homepage</a>, the <a href="/sitemap-index.xml">sitemap</a>, or
          <a href="/llms.txt">llms.txt</a> for a full list of pages.
        </p>
      </section>
    </main>
    <BlogFooter />
  </div>
</Layout>
