---
import AboutPage from "@/components/AboutPage.astro";
import StructuredData from "@/components/StructuredData.astro";
import { ABOUT_EN } from "@/data/about";
import Layout from "@/layouts/Layout.astro";
import { ABOUT_ALTERNATES } from "@/utils/about-alternates";
---

<Layout
  title={ABOUT_EN.title}
  description={ABOUT_EN.description}
  lang="en"
  dir="ltr"
  alternates={ABOUT_ALTERNATES}
>
  <StructuredData type="Person" data={{}} />
  <AboutPage content={ABOUT_EN} />
</Layout>
