---
import AboutPage from "@/components/AboutPage.astro";
import StructuredData from "@/components/StructuredData.astro";
import { ABOUT_HE } from "@/data/about";
import Layout from "@/layouts/Layout.astro";
import { ABOUT_ALTERNATES } from "@/utils/about-alternates";
---

<Layout
  title={ABOUT_HE.title}
  description={ABOUT_HE.description}
  lang="he"
  dir="rtl"
  alternates={ABOUT_ALTERNATES}
>
  <StructuredData type="Person" data={{}} />
  <AboutPage content={ABOUT_HE} />
</Layout>
