{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "astro",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?tomerwave\\.md$"
        }
      ],
      "destination": "/index.md",
      "permanent": false
    },
    {
      "source": "/blog",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?tomerwave\\.md$"
        }
      ],
      "destination": "/blog.md",
      "permanent": false
    },
    {
      "source": "/posts",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?tomerwave\\.md$"
        }
      ],
      "destination": "/posts.md",
      "permanent": false
    },
    {
      "source": "/about",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?tomerwave\\.md$"
        }
      ],
      "destination": "/about.md",
      "permanent": false
    },
    {
      "source": "/leadership",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?tomerwave\\.md$"
        }
      ],
      "destination": "/leadership.md",
      "permanent": false
    },
    {
      "source": "/archives",
      "has": [
        {
          "type": "host",
          "value": "^(www\\.)?tomerwave\\.md$"
        }
      ],
      "destination": "/archives.md",
      "permanent": false
    },
    {
      "source": "/archives",
      "destination": "/posts",
      "permanent": true
    },
    {
      "source": "/search",
      "destination": "/posts",
      "permanent": true
    },
    {
      "source": "/tags/:path(.*)",
      "destination": "/posts",
      "permanent": true
    },
    {
      "source": "/page/:page(\\d+)",
      "destination": "/posts",
      "permanent": true
    },
    {
      "source": "/posts/:page(\\d+)",
      "destination": "/posts",
      "permanent": true
    },
    {
      "source": "/leadership",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:year(\\d{4})/:month(\\d{2})/:day(\\d{2})/:slug",
      "destination": "/posts/:slug",
      "permanent": true
    },
    {
      "source": "/blog/:year(\\d{4})/:month(\\d{2})/:day(\\d{2})/:slug",
      "destination": "/posts/:slug",
      "permanent": true
    },
    {
      "source": "/blog/:slug([^\\/]+)$",
      "destination": "/posts/:slug",
      "permanent": true
    },
    {
      "source": "/categories/:category(.*)",
      "destination": "/tags/:category",
      "permanent": true
    },
    {
      "source": "/tag/:tag",
      "destination": "/tags/:tag",
      "permanent": true
    },
    {
      "source": "/20:year/:month/:day/:slug(.*)",
      "destination": "/posts/:slug",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*).txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "x-humans",
          "value": "/humans.txt"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://tomerwave.com https://*.vercel.app https://platform.twitter.com https://syndication.twitter.com https://player.vimeo.com https://vimeo.com; script-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: https://tomerwave.com https://*.vercel.app https://platform.twitter.com https://cdn.syndication.twimg.com https://player.vimeo.com https://vercel.live https://va.vercel-scripts.com; style-src 'self' 'unsafe-inline' https://tomerwave.com https://*.vercel.app https://platform.twitter.com; img-src 'self' data: https: blob: https://ghchart.rshah.org; font-src 'self' https://tomerwave.com https://*.vercel.app; connect-src 'self' https://tomerwave.com https://*.vercel.app https://platform.twitter.com https://player.vimeo.com https://vimeo.com https://vitals.vercel-insights.com https://va.vercel-scripts.com; media-src 'self' https://tomerwave.com https://*.vercel.app https://player.vimeo.com https://vimeo.com; object-src 'none'; frame-ancestors 'none'; frame-src https://platform.twitter.com https://syndication.twitter.com https://player.vimeo.com https://vercel.live https://www.youtube.com https://youtube.com https://*.youtube.com https://www.youtube-nocookie.com https://*.youtube-nocookie.com; worker-src 'self' blob:"
        }
      ]
    }
  ]
}
